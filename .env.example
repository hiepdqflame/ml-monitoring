# Local teaching defaults; credentials are not suitable for public deployment.
# Copy once: cp .env.example .env
USER=mlmonitoring
AIRFLOW_PORT=18080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=local-monitoring-demo-key
MONITOR_MLFLOW_PORT=15000
MONITOR_API_PORT=18010
MONITOR_EVIDENTLY_PORT=18011
MONITOR_PROMETHEUS_PORT=19091
MONITOR_ALERTMANAGER_PORT=19093
MONITOR_GRAFANA_PORT=13001
MONITOR_MINIO_PORT=19000
MONITOR_MINIO_CONSOLE_PORT=19001

# Automation: drift hourly, health every 15 minutes (UTC).
# Set both to false and recreate Airflow for a manual-only demonstration.
MONITOR_SCHEDULES_ENABLED=true
AUTO_RETRAIN_ENABLED=true
# Automatic retraining reuses the labeled Wine dataset: lifecycle demo only.
RETRAIN_COOLDOWN_SECONDS=21600
RETRAIN_DAILY_LIMIT=3

# Optional: Airflow and Alertmanager use the same bot.
# Run python3 scripts/configure_telegram.py; never commit .env.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
